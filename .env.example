# 嵌入向量模型 (Ollama)
EMBEDDING_MODEL_NAME="bge-m3:latest"

# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# Milvus 向量数据库配置
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=EnglishTwoEvaluate
MILVUS_COLLECTION_NAME=kaoyan_english_kb

# DeepSeek 模型调用配置
# 请替换为您自己的 DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# 邮件服务配置 (可选。如果不配置，系统自动运行在终端仿真模拟模式)
# SMTP_SERVER=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your_email@qq.com
# SMTP_PASSWORD=your_email_auth_token
# SMTP_SENDER_NAME=考研英语二写作智能评卷系统
# SMTP_USE_SSL=true
